# ---------- Painel administrativo ----------
# Senha de acesso da diretoria ao /admin
ADMIN_PASSWORD=troque-esta-senha
# Chave longa e aleatória usada para assinar o cookie de sessão (ex.: openssl rand -hex 32)
ADMIN_SECRET=

# ---------- Armazenamento de conteúdo ----------
# "json" (padrão): lê/grava os arquivos em ./data — ideal para VPS/servidor próprio.
# "supabase": grava no Postgres do Supabase — necessário em hospedagens sem disco gravável (Render, Vercel).
CONTENT_STORE=json
SUPABASE_URL=
# Chave pública do projeto (sb_publishable_... ou a "anon" antiga)
SUPABASE_KEY=
# Token criado pelo supabase/schema.sql: select value from private.config where key = 'write_token';
SUPABASE_PORTAL_TOKEN=

# ---------- Pagamentos (Mercado Pago) ----------
# Sem token o checkout roda em MODO DEMONSTRAÇÃO (Pix simulado, nada é cobrado).
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Painel MP > Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=
# URL pública do site (usada nos retornos do checkout e no webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
